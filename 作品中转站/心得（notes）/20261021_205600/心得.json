  "summary": "\u7528 RANSAC \u5728\u542B\u7EA6\u4E09\u5206\u4E4B\u4E00\u98DE\u70B9\u7684\u4E8C\u7EF4\u70B9\u96C6\u4E0A\u62DF\u5408\u76F4\u7EBF\uFF0C\u5E76\u4E0E\u666E\u901A\u6700\u5C0F\u4E8C\u4E58\u5BF9\u7167\u659C\u7387\u4E0E\u622A\u8DDD\u8BEF\u5DEE\u3002",
