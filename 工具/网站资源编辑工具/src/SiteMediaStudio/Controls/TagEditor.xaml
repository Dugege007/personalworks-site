<UserControl x:Class="PersonalWorks.SiteMediaStudio.Controls.TagEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PersonalWorks.SiteMediaStudio.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="PresetDeleteMark" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Margin="{TemplateBinding Padding}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl x:Name="ChipList" Margin="0,0,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border MouseLeftButtonUp="OnChipClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource ControlFaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="2"/>
                                <Setter Property="Margin" Value="0,0,4,4"/>
                                <Setter Property="Padding" Value="6,1,1,1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowsComposer, RelativeSource={RelativeSource AncestorType=controls:TagEditor}}" Value="False">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UseCount}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,2,0"
                                       Visibility="{Binding ShowsComposer, RelativeSource={RelativeSource AncestorType=controls:TagEditor}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>
                            <Button Content="×"
                                    Style="{StaticResource PresetDeleteMark}"
                                    Padding="4,0,2,0"
                                    ToolTip="从当前资源去掉"
                                    Click="OnChipRemoveClick"
                                    Visibility="{Binding IsEditingEnabled, RelativeSource={RelativeSource AncestorType=controls:TagEditor}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Visibility="{Binding ShowsComposer, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox x:Name="InputBox"
                     IsEnabled="{Binding IsEditingEnabled, ElementName=Root}"
                     PreviewKeyDown="OnInputPreviewKeyDown"
                     TextChanged="OnInputTextChanged"
                     GotKeyboardFocus="OnInputGotFocus"
                     LostKeyboardFocus="OnInputLostFocus"/>
        </StackPanel>
        <Popup x:Name="SuggestPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=InputBox}"
               StaysOpen="True"
               AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    MaxHeight="220">
                <ListBox x:Name="SuggestList"
                         MaxHeight="220"
                         Focusable="False"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         PreviewMouseLeftButtonDown="OnSuggestMouseDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="×"
                                        Style="{StaticResource PresetDeleteMark}"
                                        ToolTip="删除预设"
                                        Click="OnPresetDeleteClick"
                                        Visibility="{Binding AllowPresetDelete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
