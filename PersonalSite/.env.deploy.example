# 复制为 .env.deploy 后填写。该文件已被 gitignore，不要提交密钥。

# SSH（本机需已安装 OpenSSH，并能免密登录）
DEPLOY_SSH_HOST=your.server.ip
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_PORT=22
# 本机私钥完整路径，例如 C:/Users/you/.ssh/id_ed25519
# 公钥是同名的 .pub 文件，只把 .pub 内容贴到服务器；私钥不要上传、不要发给任何人
DEPLOY_SSH_KEY=
DEPLOY_REMOTE_ROOT=/www/wwwroot/example.com
# 可选。默认自动探测 nginx 或宝塔路径并执行 reload
# DEPLOY_NGINX_CMD=/www/server/nginx/sbin/nginx -t && /www/server/nginx/sbin/nginx -s reload

# 构建时注入。未接 CDN 时留空；接好后改为你的资源域名，例如 https://cdn.example.com
VITE_ASSET_BASE=

# COS：同步 public/placeholders 下媒体。仅发静态包时可留空并使用 npm run deploy -- --spa
COS_SECRET_ID=
COS_SECRET_KEY=
# 形如 my-bucket-1250000000
COS_BUCKET=
# 例如 ap-beijing、ap-shanghai
COS_REGION=
# CDN URL 刷新复用上列密钥。填写密钥的云账号须具备 cdn:PurgeUrlsCache。
# VITE_ASSET_BASE 须为 https 资源域名才能提交刷新。
